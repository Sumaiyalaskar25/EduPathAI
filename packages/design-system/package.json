{
  "name": "@edupathai/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EduPathAI design tokens, CSS variables, and shared Tailwind CSS preset derived from the frontend UI design spec.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}