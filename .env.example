# Backend environment template. Copy to .env and fill in real values.

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edupathai

# Cache (optional)
REDIS_URL=redis://localhost:6379/0

# LLM providers (at least one required for real matching)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# API server
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Observability (optional)
LOG_LEVEL=INFO
